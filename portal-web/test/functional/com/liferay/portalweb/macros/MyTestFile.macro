definition {

	macro goToSimulator {
		Click(locator1 = "MyTestFile#ELEMENT_CUSTOM_VIEW_SIMULATOR");

		Click(locator1 = "MyTestFile#ELEMENT_CUSTOM_VIEW");
	}

	macro typeAndAssertThatFieldsAreCompleted {
		Type(
			locator1 = "MyTestFile#TYPE_VALUE_HEIGHT",
			value1 = "1920");

		Type(
			locator1 = "MyTestFile#TYPE_VALUE_WIDTH",
			value1 = "1080");

		AssertElementPresent(locator1 = "MyTestFile#TYPE_VALUE_WIDTH");

		AssertElementPresent(locator1 = "MyTestFile#TYPE_VALUE_HEIGHT");
	}

	macro viewEntryContent {
		var key_language = "${language}";
		var key_age = "${age}";
		var key_fullName = "${name}";

		AssertTextEquals(
			locator1 = "MyTestFile#FOUND_CORRECT_ROW",
			value1 = "${key_fullName}");
	}

	macro viewSimulator {
		Click(locator1 = "MyTestFile#ELEMENT_CUSTOM_VIEW");

		Click(locator1 = "MyTestFile#ELEMENT_SIMULATION_VIEW");
	}

	macro waitElementAppearAndClick {
		WaitForElementPresent(locator1 = "MyTestFile#VALIDATE_STRING");

		Click(locator1 = "MyTestFile#VALIDATE_STRING");
	}

}