@component-name = "portal-lima"
definition {
    
        property testray.main.component.name = "Blogs";

    setUp {

        TestCase.setUpPortalInstance();

        User.firstLoginPG();
            
        Navigator.openURL();
            
        JSONLayout.addPublicLayout(
            groupName = "Guest",
            layoutName = "Blogs Page");

        JSONLayout.addWidgetToPublicLayout(
            groupName = "Guest",
            layoutName = "Blogs Page",
            widgetName = "Blogs");

        Navigator.gotoPage(pageName = "Blogs Page");
    }
    
    tearDown {

        var testPortalInstance = PropsUtil.get("test.portal.instance");
        
        if ("${testPortalInstance}" == "true") {
            PortalInstances.tearDownCP();
        }

        else {
        BlogsEntry.tearDownCP();

        JSONLayout.deletePublicLayout( 
            groupName = "Guest",
            layoutName = "Blogs Page");

        }
    }

    @description = "Can Create a Blog"
    @priority = "5"
    test CanCreateBlog {

        Blogs.addEntry(
            entryTitle = "Title Blog",
            entryContent = "Content Blog");

		BlogsNavigator.gotoEntryPG(
			entryContent = "Content Blog",
			entryTitle = "Title Blog");

		BlogsEntry.viewEntryPG(
			entryContent = "Content Blog",
			entryTitle = "Title Blog");

    }

    @description = "Can Edit a Blogs"
    @priority = "5"

    test CanEditBlog {
       
        Navigator.gotoPage(pageName = "Blogs Page");

        Blogs.addEntry(
            entryTitle = "Title Blog",
            entryContent = "Content Blog");

        Blogs.editEntryPG(
            entryContent = "Content Blog",
            entryContentEdit = "My Content Blog Edited",
            entryTitle = "Title Blog",
            entryTitleEdit = "My Blogs Title Edited");

        BlogsNavigator.gotoEntryPG(
			entryContent = "My Content Blog Edited",
			entryTitle = "My Blogs Title Edited");

		BlogsEntry.viewEntryPG(
			entryContent = "My Content Blog Edited",
			entryTitle = "My Blogs Title Edited");

    }
    @description = "Can Delete a Blog"
    @priority = "5"

    test CanDeleteBlog {

        Navigator.gotoPage(pageName = "Blogs Page");

        Blogs.addEntry(
            entryTitle = "Title Blog",
            entryContent = "Content Blog");

        BlogsEntry.moveToRecycleBinPG(
            entryContent = "Content Blog",
            entryTitle = "Title Blog");

        Navigator.openURL();

        SearchPortlets.searchEmbedded(searchTerm = "Title Blog");

        SearchResultPortlet.viewSearchResultNotPresent(
			searchAssetTitle = "Title Blog",
			searchAssetType = "Blogs Entry");

    }
    @description = "Can Search Blogs"
    @priority = "5"

    test CanSearchBlogs {

        Navigator.gotoPage(pageName = "Blogs Page");

        Blogs.addEntry(
            entryTitle = "My Title Blog 1",
            entryContent = "Content Blog");

        Blogs.addEntry(
            entryTitle = "My Title Blog 2",
            entryContent = "Content Blog");

        Navigator.openURL();

        SearchPortlets.searchEmbedded(searchTerm = "My Title Blog 1");

        SearchResultPortlet.viewSearchResults(
			searchAssetSummary = "Content Blog",
			searchAssetTitle = "My Title Blog 1",
			searchAssetType = "Blogs Entry");

        Navigator.openURL();

        SearchPortlets.searchEmbedded(searchTerm = "My Title Blog 2");

        SearchResultPortlet.viewSearchResults(
			searchAssetSummary = "Content Blog",
			searchAssetTitle = "My Title Blog 2",
			searchAssetType = "Blogs Entry");

    }

}