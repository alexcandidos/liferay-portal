@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Blogs Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "Blogs Page",
			widgetName = "Blogs");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}

		BlogsEntry.tearDownCP();

		JSONLayout.deletePublicLayout(
			groupName = "Guest",
			layoutName = "Blogs Page");
	}

	@description = "Can Create a Blog"
	@priority = "5"
	test CanCreateBlog {
		task ("Create Blogs and publish him in a public layout") {
			BlogsNavigator.openToAddEntry(
				layoutName = "Blogs Page",
				siteURLKey = "guest");

			BlogsEntry.addEntryContent(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Content test");

			PortletEntry.publish();
		}

		task ("Assert that elements is equal to cod") {
			Navigator.gotoPage(pageName = "Blogs Page");

			MyBlogTests.viewBlogsEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Content test");

			MyBlogTests.assertBlogEntryTitleAndContent(
				contentValue = "Blogs Content",
				titleValue = "Blogs Content test");
		}
	}

	@description = "Can Delete a Blog"
	@priority = "5"
	test CanDeleteBlog {
		task ("Blogs is added a page") {
			JSONBlog.addEntry(
				entryContent = "Blogs Content1",
				entryTitle = "Blogs Content test1");

			JSONBlog.addEntry(
				entryContent = "Blogs Content 2",
				entryTitle = "Blogs Content test 2");

			Navigator.gotoPage(pageName = "Blogs Page");
		}

		task ("Assert blogs are corrects") {
			MyBlogTests.viewBlogsEntry(
				entryContent = "Blogs Content1",
				entryTitle = "Blogs Content test1");

			MyBlogTests.assertViewBlogEntryTitleAndContent(
				contentValue = "Blogs Content1",
				viewEntryTitleBlog = "Blogs Content test1");

			Navigator.gotoPage(pageName = "Blogs Page");

			MyBlogTests.viewBlogsEntry(
				entryContent = "Blogs Content 2",
				entryTitle = "Blogs Content test 2");

			MyBlogTests.assertViewBlogEntryTitleAndContent(
				contentValue = "Blogs Content 2",
				viewEntryTitleBlog = "Blogs Content test 2");
		}

		task ("Excluding the first blog created") {
			Navigator.gotoPage(pageName = "Home");

			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

			BlogsEntry.moveToRecycleBinCP(
				assetType = "Blogs Entry",
				entryTitle = "Blogs Content test1");
		}

		task ("Confirm that Blog 01 are exclused and Blog 02 exists.") {
			Navigator.gotoPage(pageName = "Blogs Page");

			MyBlogTests.assertBlogElementNotPresent(
				contentValue = "Blogs Entry Content Edit",
				titleValue = "Blogs Entry Title Edit");

			Navigator.gotoPage(pageName = "Blogs Page");

			MyBlogTests.viewBlogsEntry(
				entryContent = "Blogs Content 2",
				entryTitle = "Blogs Content test 2");

			MyBlogTests.assertBlogEntryTitleAndContent(
				contentValue = "Blogs Content 2",
				titleValue = "Blogs Content test 2");
		}
	}

	@description = "Can Create a Blog"
	@priority = "5"
	test CanEditBlog {
		task ("Editing Blogs Entry") {
			JSONBlog.addEntry(
				entryContent = "Blogs Content",
				entryTitle = "Blogs Content test");

			Navigator.gotoPage(pageName = "Blogs Page");

			Blogs.editEntryPG(
				entryContent = "Blogs Content",
				entryContentEdit = "Blogs Entry Content Edit",
				entryTitle = "Blogs Content test",
				entryTitleEdit = "Blogs Entry Title Edit");
		}

		task ("Confirming that haved sucess") {
			MyBlogTests.viewBlogsEntry(
				entryContent = "Blogs Entry Content Edit",
				entryTitle = "Blogs Entry Title Edit");

			MyBlogTests.assertBlogEntryTitleAndContent(
				contentValue = "Blogs Entry Content Edit",
				titleValue = "Blogs Entry Title Edit");
		}
	}

	@description = "Can Search Blogs"
	@priority = "5"
	test CanSearchBlogs {
		task ("Creating a Layout and a 2 Blogs") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Search Page");

			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Search Page",
				widgetName = "Blogs");

			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

			Blogs.addEntry(
				entryContent = "Blogs Content1",
				entryTitle = "Blogs Title test1");

			Blogs.addEntry(
				entryContent = "Murder is found in river",
				entryTitle = "News");
		}

		task ("Checking if the search are correct and appears others results") {
			Navigator.gotoPage(pageName = "Search Page");

			SearchPortlets.searchEmbedded(searchTerm = "Blogs Title test1");

			SearchResultPortlet.viewSearchResults(
				searchAssetTitle = "Blogs Title test1",
				searchAssetType = "Blogs Entry",
				searchTerm = "Blogs Title test1");

			MyBlogTests.assertThatOnlyOneBlogsAppears(
				searchAssetTitle = "Blogs Title test1",
				searchAssetType = "Blogs Entry",
				searchTerm = "Blogs Title test1");

			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Search Page");
		}
	}

}