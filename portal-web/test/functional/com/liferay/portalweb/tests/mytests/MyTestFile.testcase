@component-name = "portal-web-forms-and-data-lists"
definition {
    property testray.main.component.name = "Forms";

    setUp {
        TestCase.setUpPortalInstance();

        User.firstLoginPG();

        Navigator.openURL();
    }

    tearDown {
        User.logoutAndLoginPG(
            userLoginEmailAddress = "test@liferay.com",
            userLoginFullName = "Test Test");
    }


    @description = "Validating translation"
    @priority = "5"
    test ValidateTranslation {

        FormsAdmin.addForm();

        Form.editName(formName = "A cool title");

        Form.editDescription(formDescription = "A nice description");


        Form.gotoAddField(fieldType = "Numeric");

        Form.editFieldLabelMetal(fieldValue = "Age");


        Form.editPageTitle(
			formPageName = "Form",
			formTitleNumber = "1");
        
        Form.save();

         Form.gotoAddField(fieldType = "Text");

        Form.editFieldLabelMetal(fieldValue = "Full Name");

        Form.save();

        Form.addTranslation(localizedLanguage = "Portuguese (Brazil)");

        FormViewBuilder.editFieldLabel(fieldLabel = "Full Name", label = "Nome Completo");

        FormViewBuilder.editFieldLabel(fieldLabel = "Age", label = "Idade");        
    
        Form.save();

        Form.publishForm();

        FormsAdminNavigator.gotoPublishedForm();

        FormFields.editText(fieldName = "Full Name",
			fieldValue = "Davi Santos");

        FormFields.editText(fieldName = "Age",
			fieldValue = "19");

        FormPortlet.submitSuccessfully();

        Form.submitAgain();

         FormPortletConfiguration.changeLanguage(
            currentLanguage = "en-US",
            newLanguage = "português-Brasil");

            FormFields.editText(
            fieldLabel = "Text", 
            fieldName = "Text",
            fieldValue = "Davi Santos");

            FormFields.editText(
            fieldLabel = "Numeric", 
            fieldName = "Numeric",
            fieldValue = "19");

           FormPortlet.submitSuccessfully();
        
        Navigator.openURL();

        ProductMenu.gotoPortlet(category = "Content & Data", portlet = "Forms");
        
        FormsAdminNavigator.gotoViewEntries();

  
    }

           
       


}
