definition {

	macro changeHeigthAndWidth {
		Type(
			locator1 = "MyTestFile#CHANGE_HEIGTH",
			value1 = "1920");

		Type(
			locator1 = "MyTestFile#CHANGE_WIDTH",
			value1 = "1080");
	}

	macro control_Panel {
		Click(locator1 = "MyTestFile#OPEN_CONTROL_PANEL");
	}

	macro open_System_Settings {
		Click(locator1 = "MyTestFile#OPEN_SYSTEM_SETTINGS");
	}

	macro openCustom {
		Click(locator1 = "MyTestFile#OPEN_CUSTOM");
	}

	macro openMenu {
		Click(locator1 = "MyTestFile#OPEN_MENU");
	}

	macro openSimulation {
		Click(locator1 = "MyTestFile#OPEN_SIMULATION");
	}

	macro validatHigthAndWidth {
		AssertTextEquals(
			locator1 = "MyTestFile#CHANGE_HEIGTH",
			value1 = "1920");

		AssertTextEquals(
			locator1 = "MyTestFile#CHANGE_WIDTH",
			value1 = "1080");
	}

}