definition {

    macro applicationsMenuClick {
        Click(locator1 = "MyTestFile#APPLICATIONS_MENU");
    }

    macro controlPanelClick {
        Click(locator1 = "MyTestFile#CONTROL_PANEL");
    }

    macro configurationAssert {
        AssertElementPresent(locator1 = "MyTestFile#CONFIGURATION");

    }

    macro simulationClick {
        Click(locator1 = "MyTestFile#SIMULATION");

    }

    macro customClick {
        Click(locator1 = "MyTestFile#CUSTOM");

    }

    macro heightModification {
        Type(locator1 = "MyTestFile#HEIGHT", value1 = "1920");
        

    }

    macro widthModification {
        Type(locator1 = "MyTestFile#WIDTH", value1 = "1080");
        
    }

    macro closeButtonClick {
        Click(locator1 = "MyTestFile#CLOSE_BUTTON");
    }
}
