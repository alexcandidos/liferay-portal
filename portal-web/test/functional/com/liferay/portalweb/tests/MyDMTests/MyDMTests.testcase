@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Documents and Media Page");

		JSONLayout.addWidgetToPublicLayout(
			groupName = "Guest",
			layoutName = "Documents and Media Page",
			widgetName = "Documents and Media");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			ProductMenu.gotoPortlet(
				category = "Site Builder",
				portlet = "Pages");

			PagesAdmin.deletePage(pageName = "Documents and Media Page");
		}
	}

	@description = "Can Create a Documents and Media"
	@priority = "5"
	test CanCreateDM {
		task ("When the user create a Documents and Media (Upload the file)") {
			DMDocument.addCP(
				dmDocumentDescription = "DM Document with DM Document Type Description",
				dmDocumentFile = "Rey-Alloy.png",
				dmDocumentTitle = "Rey-Alloy.png");
		}

		task ("Then the Documents and Media should display on the page") {
			Navigator.gotoPage(pageName = "Documents and Media Page");

			DMDocument.viewPG(dmDocumentTitle = "Rey-Alloy.png");
		}
	}

	@description = "Can Delete a Documents and Media"
	@priority = "5"
	test CanDeleteDM {
		task ("Given the DM Portlet is added to the page and create 2 Documents and Media (Upload the file)") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "DM Document Description",
				dmDocumentTitle = "DM Document JPG",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "Document_4.jpg");

			DMDocument.addCP(
				dmDocumentDescription = "DM Document with DM Document Type Description",
				dmDocumentFile = "Rey-Alloy.png",
				dmDocumentTitle = "Rey-Alloy.png");
		}

		task ("When the User delete a document and media") {
			DMDocument.deleteCP(dmDocumentTitle = "DM Document JPG");
		}

		task ("Then DMTest 1 should not exist and DMTest 2 should exist") {
			Navigator.gotoPage(pageName = "Documents and Media Page");

			DMDocument.viewPG(dmDocumentTitle = "Rey-Alloy.png");
		}
	}

	@description = "Can Download a Documents and Media"
	@priority = "5"
	test CanDownloadDM {
		task ("Given the DM Portlet is added to the page and create 2 Documents and Media (Upload the file)") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "DM Document Description",
				dmDocumentTitle = "DM Document JPG",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "Document_4.jpg");

			DMDocument.addCP(
				dmDocumentDescription = "DM Document with DM Document Type Description",
				dmDocumentFile = "Rey-Alloy.png",
				dmDocumentTitle = "Rey-Alloy.png");
		}

		task ("When the user download document from DMTest1 (Rey-Alloy.png)") {
			DMDocument.downloadCP(
				dmDocumentSize = "34 KB",
				dmDocumentTitle = "Rey-Alloy.png");
		}
	}

	@description = "Can Edit a Documents and Media"
	@priority = "5"
	test CanEditDM {
		task ("Given the DM Portlet is added to the page and create a Document and Media (Upload the file)") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "DM Document Description",
				dmDocumentTitle = "DM Document JPG",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "Document_4.jpg");
		}

		task ("When the User edits the Documents and Media (Change DM name and the file)") {
			Navigator.gotoPage(pageName = "Documents and Media Page");

			DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

			DMDocument.editCP(
				dmDocumentFileEdit = "Commerce_Black.jpg",
				dmDocumentFileNameEdit = "Commerce_Black.jpg",
				dmDocumentTitle = "DM Document JPG",
				dmDocumentTitleEdit = "Title Edited");
		}

		task ("Then the Documents and Media should be edited") {
			Navigator.gotoPage(pageName = "Documents and Media Page");

			DMDocument.viewPG(dmDocumentTitle = "Title Edited");
		}
	}

}