@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Documents and Media"
	@priority = "5"
	test CanCreateDM {
		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Documents and Media Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "Documents and Media Page",
			widgetName = "Documents and Media");

		Navigator.gotoPage(pageName = "Documents and Media Page");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document Description",
			dmDocumentTitle = "DM Document Title",
			groupName = "Guest",
			mimeType = "text/plain",
			sourceFileName = "Document_1.txt");

		Refresh();

		DMNavigator.gotoDocumentCP(dmDocumentTitle = "DM Document Title");

		IsElementPresent(
			key_rowEntry = "DM Document Title",
			locator1 = "ContentRow#ENTRY_CONTENT_ENTRY_NAME");
	}

	@description = "Can Delete a Documents and Media"
	@priority = "5"
	test CanDeleteDM {
		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Documents and Media Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "Documents and Media Page",
			widgetName = "Documents and Media");

		Navigator.gotoPage(pageName = "Documents and Media Page");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document1 Description",
			dmDocumentTitle = "DM Document1 Title",
			groupName = "Guest",
			mimeType = "text/plain",
			sourceFileName = "Document_1.txt");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document2 Description",
			dmDocumentTitle = "DM Document2 Title",
			groupName = "Guest",
			mimeType = "text/plain",
			sourceFileName = "Document_2.txt");

		Refresh();

		JSONDocument.deleteFile(
			dmDocumentTitle = "DM Document1 Title",
			groupName = "Guest");

		Refresh();

		AssertElementPresent(
			key_dmDocumentTitle = "DM Document2 Title",
			locator1 = "DocumentsAndMedia#PAGE_DOCUMENT_TITLE");

		AssertElementNotPresent(
			key_dmDocumentTitle = "DM Document1 Title",
			locator1 = "DocumentsAndMedia#PAGE_DOCUMENT_TITLE");
	}

	@description = "Can Download a Documents and Media"
	@priority = "5"
	test CanDownloadDM {
		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Documents and Media Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "Documents and Media Page",
			widgetName = "Documents and Media");

		Navigator.gotoPage(pageName = "Documents and Media Page");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document1 Description",
			dmDocumentTitle = "DM Document1 Title",
			groupName = "Guest",
			mimeType = "text/plain",
			sourceFileName = "Document_1.txt");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentDescription = "DM Document2 Description",
			dmDocumentTitle = "DM Document2 Title",
			groupName = "Guest",
			mimeType = "text/plain",
			sourceFileName = "Document_2.txt");

		Refresh();

		DMDocument.downloadPG(dmDocumentTitle = "DM Document1 Title");

		DMDocument.assertFileNameFromTempFolder(fileName = "Document_1.txt");

		DMDocument.assertNoFileNameFromTempFolder(fileName = "Document_2.txt");
	}

	@description = "Can Edit a Documents and Media"
	@priority = "5"
	test CanEditDM {
		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Documents and Media Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "Documents and Media Page",
			widgetName = "Documents and Media");

		Navigator.gotoPage(pageName = "Documents and Media Page");

		JSONDocument.addFileWithUploadedFile(
			dmDocumentTitle = "DM Document JPG",
			groupName = "Guest",
			mimeType = "image/jpeg",
			sourceFileName = "Document_4.jpg");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMDocument.editCP(
			dmDocumentFileEdit = "Commerce_Black.jpg",
			dmDocumentFileNameEdit = "Commerce_Black.jpg",
			dmDocumentTitle = "DM Document JPG",
			dmDocumentTitleEdit = "DM Document JPG Edited");

		Refresh();

		DMDocument.viewEditCP(dmDocumentTitleEdit = "DM Document JPG Edited");
	}

}