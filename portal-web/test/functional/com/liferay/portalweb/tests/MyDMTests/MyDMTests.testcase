@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Documents and Media"
	@priority = "5"
	test CanCreateDM {
		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "DM Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "DM Page",
			widgetName = "Documents and Media");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMDocument.addCP(
			dmDocumentDescription = "DM Document Description",
			dmDocumentFile = "Document_1.txt",
			dmDocumentTitle = "DM Document Title");
	}

	@description = "Can Delete a Documents and Media"
	@priority = "5"
	test CanDeleteDM {
		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "DM Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "DM Page",
			widgetName = "Documents and Media");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMDocument.addCP(
			dmDocumentDescription = "DM Document Description",
			dmDocumentFile = "Document_1.txt",
			dmDocumentTitle = "DM Document Title");

		DMDocument.deleteCP(dmDocumentTitle = "DM Document Title");
	}

	@description = "Can Download a Documents and Media"
	@priority = "5"
	test CanDownloadDM {
		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "DM Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "DM Page",
			widgetName = "Documents and Media");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMDocument.addCP(
			dmDocumentDescription = "DM Document Description",
			dmDocumentFile = "Document_1.txt",
			dmDocumentTitle = "DM Document Title");

		DMDocument.addCP(
			dmDocumentDescription = "DM Document Description2",
			dmDocumentFile = "Document_2.txt",
			dmDocumentTitle = "DM Document Title2");

		DMDocument.downloadCP(
			dmDocumentSize = "519 B",
			dmDocumentTitle = "DM Document Title");
	}

	@description = "Can Edit a Documents and Media"
	@priority = "5"
	test CanEditDM {
		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "DM Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "1",
			groupName = "Guest",
			layoutName = "DM Page",
			widgetName = "Documents and Media");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMDocument.addCP(
			dmDocumentDescription = "DM Document Description",
			dmDocumentFile = "Document_1.txt",
			dmDocumentTitle = "DM Document Title");

		DMDocument.editPG(
			dmDocumentFileEdit = "Document_1.pdf",
			dmDocumentTitle = "DM Document Title",
			dmDocumentTitleEdit = "DM Ducument Title 2");
	}

}