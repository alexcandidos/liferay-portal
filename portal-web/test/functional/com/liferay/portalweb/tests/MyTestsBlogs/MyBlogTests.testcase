	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();

		JSONBlog.addEntry(
			entryContent = "Blogs Entry Content 2",
			entryTitle = "Blogs Entry Title 2");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}

		BlogsEntry.tearDownCP();
	}

	@description = "Can Create a Blog"
	@priority = "5"
	test CanCreateBlog {
		task ("Create Blog") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

			Blogs.addEntry(
				entryContent = "Blogs Entry Content 1",
				entryTitle = "Blogs Entry Title 1");
		}

		task ("Add Widget Blogs") {
			Navigator.gotoPage(pageName = "Home");

			MyBlogTest.clickToControlMenu();

			PageEditor.addWidgetViaKeyboard(
				categoryName = "Collaboration",
				widgetName = "Blogs");

			PortletEntry.publish();
		}

		task ("Check Create Method Blogs") {
			MyBlogTest.viewEntryCP(
				entryContent = "Blogs Entry Content 1",
				entryTitle = "Blogs Entry Title 1");
		}
	}

	@description = "Can Delete a Blog"
	@priority = "5"
	test CanDeleteBlog {
		task ("Delete Method Blogs") {
			MyBlogTest.deleteBlogEntry(index = "1");
		}

		task ("Check Delete Method Blogs") {
			MyBlogTest.checkElementNotPresent(entryTitle = "Blogs Entry Content 1");

			MyBlogTest.checkElementPresent(entryTitle = "Blogs Entry Content 2");
		}

	@description = "Can Edit a Blog"
	@priority = "5"
	test CanEditBlog {
		task ("Edit Method blogs") {
			BlogsEntry.editContentViaCardViewPG(
				entryContent = "Blogs Entry Content 1",
				entryContentEdit = "Blogs Entry Content Edited",
				entryTitle = "Blogs Entry Title 1");

			PortletEntry.publish();
		}

		task ("Check Edit Method blogs") {
			MyBlogTest.viewEntryCP(
				entryContent = "Blogs Entry Content Edited",
				entryTitle = "Blogs Entry Title 1");
		}
	}

	@description = "Can Search Blogs"
	@priority = "5"
	test CanSearchBlogs {
		task ("Search for first added blog") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

			MyBlogTest.searchEmbedded(searchTerm = "\"\"Blogs Entry Title 1\"\"");
		}

		task ("Check first added blog") {
			MyBlogTest.checkElementNotPresentSearch(title = "Blogs Entry Title 1");
		}

		task ("Search for second added blog") {
			MyBlogTest.searchEmbedded(searchTerm = "\"\"Blogs Entry Title 2\"\"");
		}

		task ("Check second added blog") {
			MyBlogTest.checkElementPresent(title = "Blogs Entry Title 2");
		}
	}

	}

