definition {

	macro checkElementNotPresent {
		var key_entryTitle = "${entryTitle}";

		IsElementNotPresent(locator1 = "MyBlogTest#TITLE_BLOG");
	}

	macro checkElementNotPresentSearch {
		var key_title = "${title}";

		IsElementNotPresent(locator1 = "MyBlogTest#TITLE_BLOG_SEARCH");
	}

	macro checkElementPresent {
		var key_entryTitle = "${entryTitle}";

		IsElementPresent(locator1 = "MyBlogTest#TITLE_BLOG");
	}

	macro checkElementPresentSearch {
		var key_title = "${title}";

		IsElementPresent(locator1 = "MyBlogTest#TITLE_BLOG_SEARCH");
	}

	macro clickToControlMenu {
		Click(locator1 = "MyBlogTest#BUTTON_EDIT_PAGE");
	}

	macro deleteBlogEntry {
		var key_index = "${index}";

		Click(locator1 = "MyBlogTest#OPEN_OPTIONS_BLOG");

		Click(locator1 = "MyBlogTest#DELETE_BLOG");
	}

	macro searchEmbedded {
		AssertElementPresent(locator1 = "MyBlogTest#SEARCH_FOR");

		Type(
			locator1 = "MyBlogTest#SEARCH_FOR",
			value1 = "${searchTerm}");

		Click(locator1 = "MyBlogTest#LUPA_SEARCH");
	}

	macro viewEntryCP {
		var key_entryContent = "${entryContent}";
		var key_entryTitle = "${entryTitle}";

		AssertTextEquals(
			locator1 = "MyBlogTest#TITLE_BLOG",
			value1 = "${entryTitle}");

		AssertTextEquals(
			locator1 = "MyBlogTest#CONTENT_BLOG",
			value1 = "${entryContent}");
	}

}