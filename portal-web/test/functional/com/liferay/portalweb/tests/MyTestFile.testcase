

	@description = "Set Screen size to custom and validate values"
	@priority = "5"
	test CanSetScreenSizeAndValidateValues {
		MyTestFile.goToSimulator();

		MyTestFile.typeAndAssertThatFieldsAreCompleted();
	}

	@description = "Access Portal Global Menu and validate CONFIGURATION string at Control Panel"
	@priority = "5"
	test CanValidateConfigurationStringAtControlPanel {

		MyTestFile.waitElementAppearAndClick();

		Click(locator1 = "MyTestFile#CLICK_IN_CONTROLPANEL");
	}
