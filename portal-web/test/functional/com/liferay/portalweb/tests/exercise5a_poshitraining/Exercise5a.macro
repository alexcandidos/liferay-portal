definition {

	macro appMenu {
		Click(locator1 = "Exercise5a#APPLICATIONS_MENU_BUTTON");
	}

	macro custom {
		Click(locator1 = "Exercise5a#CUSTOM");
	}

	macro height {
		Type(
			locator1 = "Exercise5a#HEIGHT",
			value1 = "800");
	}

	macro simulation {
		Click(locator1 = "Exercise5a#SIMULATION");
	}

	macro store {
		Click(locator1 = "Exercise5a#STORE");
	}

	macro tab2 {
		Click(locator1 = "Exercise5a#PRODUCT_NAV_APP_MENU_PORTLET_TAB2");
	}

	macro width {
		Type(
			locator1 = "Exercise5a#WIDTH",
			value1 = "500");
	}

}