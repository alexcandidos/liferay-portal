definition {
    property testray.main.component.name = "Forms";

    setUp {
        TestCase.setUpPortalInstance();

        User.firstLoginPG();

        Navigator.openURL();
    }

    tearDown {
        User.logoutAndLoginPG(
            userLoginEmailAddress = "test@liferay.com",
            userLoginFullName = "Test Test");
    } 

    @description = "Access Portal Global Menu and validate STORE string at Control Panel"
        test ValidateStoreStringAtControlPanel {

                Exercise5a.appMenu();

                Exercise5a.tab2();

                Exercise5a.store();

            } 

            @description = "Set Screen size to custom and validate values"
        test SetScreenSizeAndValidateValues {

                Exercise5a.simulation();

                Exercise5a.custom();

                Exercise5a.height();

                Exercise5a.width();

            } 

  }