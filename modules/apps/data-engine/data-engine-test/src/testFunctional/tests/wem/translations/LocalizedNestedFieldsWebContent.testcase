	@description = "This is a test for LPS-123537. As Content Creator, I want to leverage the structures’ translations with nested field when creating a new Web Content"
	@priority = "4"
	test VerifyDefaultLanguageIsFirstShown {
		property portal.acceptance = "false";
		
		var structureTitle = "Structure Title";

		var structureTitlePT = "Titulo da Estrutura";

		var webTitle = "WC Title";

		WebContentNavigator.openWebContentAdmin(siteURLKey = "test-site-name");
		
		NavItem.gotoStructures();

		WebContentStructures.addCP(
			structureDescription = "I'm a structure test",
			structureName = "${structureTitle}");

		DataEngine.addField(
			fieldFieldLabel = "Image",
			fieldName = "Image");

		DataEngine.addFieldNested(
			fieldName = "Numeric",
			fieldFieldLabel = "Numeric",
			targetFieldLabel = "Image");

		DataEngine.addFieldNested(
			fieldName = "Text",
			fieldFieldLabel = "Text",
			targetFieldLabel = "Numeric");

		Button.clickSave();

		WebContentNavigator.gotoEditStructure(structureName = "${structureTitle}");

		WebContentStructures.addLocalization(
			locale = "pt_BR",
			localization1Name = "${structureTitlePT}");

		FormViewBuilder.editFieldLabel(
			fieldLabel = "Fields Group",
			label = "Grupo de Campos");

		FormViewBuilder.editFieldLabel(
			fieldLabel = "Image",
			label = "Imagem");

		FormViewBuilder.editFieldLabel(
			fieldLabel = "Numeric",
			label = "Numero");

		FormViewBuilder.editFieldLabel(
			fieldLabel = "Text",
			label = "Texto");

		Button.clickSave();

		Navigator.gotoNavTab(navTab = "Web Content");

		WebContentNavigator.gotoAddWithStructureCP(structureName = "${structureTitle}");

		WebContent.addWithStructureCP(
			structureName = "WC Structure Name",
			webContentTitle = "WC WebContent Title");

		AssertTextEquals(
            locator1 = "Button#LOCALIZATION_GENERIC",
            value1 = "en-US");

		AssertTextEquals(
			locator1 = "DataEngineBuilder#FORM_FIELDS_GROUP_FIRST",
			value1 = "Fields Group");

		AssertTextEquals(
			locator1 = "DataEngineBuilder#NESTED_NUMERIC_STRUCTURE",
			value1 = "Numeric");

		AssertTextEquals(
			locator1 = "DataEngineBuilder#NESTED_TEXT_STRUCTURE",
			value1 = "Text");
	}

}