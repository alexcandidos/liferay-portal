	@description = "This is a test for LPS-98076. As a Developer, I want to Implement the HTML field type"
	@ignore = "true"
	@priority = "3"
	test SetRichTextAsRepeatable {
		property portal.acceptance = "false";

		DataEngine.addField(
			fieldFieldLabel = "Test Set Repeatable",
			fieldName = "Rich Text");

		DataEngine.editFieldRepeatable(fieldFieldLabel = "Test Set Repeatable");

		WebContentStructures.saveCP(structureName = "New Structure");

		WebContentNavigator.gotoEditStructure(structureName = "New Structure");

		AssertClick.assertPartialTextClickAt(
			key_fieldFieldLabel = "Test Set Repeatable",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER",
			value1 = "Test Set Repeatable");

		Navigator.gotoNavTab(navTab = "Advanced");

		Check.checkToggleSwitch(
			checkboxName = "Repeatable",
			locator1 = "Checkbox#ANY_CHECKBOX");
	}

