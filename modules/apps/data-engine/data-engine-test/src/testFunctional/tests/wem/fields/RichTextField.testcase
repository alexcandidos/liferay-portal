	@ignore = "true"
	@priority = "4"
	test SetRichTextSearchableAsDisabled {
		property portal.acceptance = "false";

		DataEngine.addField(
			fieldFieldLabel = "Test Searchable as Disabled",
			fieldName = "Rich Text");

		DataEngine.editFieldSearchable(
			fieldFieldLabel = "Test Searchable as Disabled",
			searchableType = "Disable");

		WebContentStructures.saveCP();

		WebContentNavigator.gotoEditStructure(structureName = "New Structure");

		AssertClick.assertPartialTextClickAt(
			key_fieldFieldLabel = "Test Searchable as Disabled",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER",
			value1 = "Test Searchable as Disabled");

		Navigator.gotoNavTab(navTab = "Advanced");

		FormFields.viewRadioValue(
			fieldName = "indexType",
			fieldValue = "Disable");
	}

