@component-name = "portal-wcm"
definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Web Content Administration";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONGroup.addGroup(groupName = "Test Site Name");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONGroup.deleteGroupByName(groupName = "Test Site Name");
		}
	}

	@description = "This is a test for LPS-123539. As Content Creator, I want to leverage the structures’ translations with fildset when creating a new Web Content"
	@ignore = "true"
	@priority = "5"
	test CheckDefaultWebContentTitleOnWebContentList {
		property portal.acceptance = "false";

		// TODO LPS-123539 CheckDefaultWebContentTitleOnWebContentList pending implementation

	}

	@description = "This is a test for LPS-123539. As Content Creator, I want to leverage the structures’ translations with fildset when creating a new Web Content"
	@ignore = "true"
	@priority = "4"
	test CheckFieldsetSummaryLocalization {
		property portal.acceptance = "false";

		// TODO LPS-123539 CheckFieldsetSummaryLocalization pending implementation
	}

	@description = "This is a test for LPS-123539. As Content Creator, I want to leverage the structures’ translations with fildset when creating a new Web Content"
	@ignore = "true"
	@priority = "4"
	test CheckLanguageSelector {
		property portal.acceptance = "false";

		var fieldsetLabel = "My New Fieldset";
		var structureTitle = "Structure Title";
		var structureTitlePT = "Titulo da Estrutura";
		var structureFieldSet = "Field Set Structure";
		var structureFieldSetPT = "Estrutura de Field Set";

		WebContentNavigator.openWebContentAdmin(siteURLKey = "test-site-name");

		NavItem.gotoStructures();

		WebContentStructures.addCP(
			structureDescription = "I'll be a field set",
			structureName = "${structureFieldSet}");

		DataEngine.addFieldsets(
			createNewFieldset = "true",
			fieldNameList = "Text",
			fieldsetLabel = "${fieldsetLabel}",
			fieldsetName = "${fieldsetLabel}");

		DataEngine.gotoFieldsetItemEllipsis(fieldsetName = "${fieldsetLabel}");

		MenuItem.click(menuItem = "Edit");

		Click(locator1 = "Button#LOCALIZATION_MODAL");

		AssertElementPresent(locator1 = "WCD#WEB_CONTENT_MODAL_TRANSLATION_SPAN_LANGUAGE_ENGLISH");

		Click(locator1 = "Modal#CLOSE_BUTTON");

		WebContentStructures.saveCP();

		Navigator.gotoNavTab(navTab = "Web Content");

		WebContentNavigator.gotoAddWithStructureCP(structureName = "${structureFieldSet}");

		WebContent.addWithStructureCP(
			structureName = "${structureFieldSet}",
			webContentTitle = "WC English");

		Click.clickNoMouseOver(locator1 = "Button#LOCALIZATION_GENERIC");

		AssertElementPresent(locator1 = "WCD#WEB_CONTENT_TRANSLATION_SPAN_LANGUAGE_ENGLISH");
	}

