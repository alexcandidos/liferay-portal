{namespace CheckboxMultiple}

{template .render}
	{@param name: string}
	{@param value: ?}
	{@param? _handleFieldChanged: any}
	{@param? errorMessage: string}
	{@param? id: string}
	{@param? inline: bool}
	{@param? label: string}
	{@param? options: list<[
		label: string,
		value: string
	]>}
	{@param? predefinedValue: list<any>}
	{@param? readOnly: bool}
	{@param? repeatable: bool}
	{@param? required: bool}
	{@param? showAsSwitcher: bool}
	{@param? showLabel: bool}
	{@param? spritemap: string}
	{@param? tip: string}
	{@param? visible: bool}
	{@param? valid: bool}

	{call FieldBase.render}
		{param contentRenderer kind="html"}
			{call .content}
				{param _handleFieldChanged: $_handleFieldChanged /}
				{param disabled: $readOnly /}
				{param inline: $inline /}
				{param name: $name /}
				{param options: $options /}
				{param predefinedValue: $predefinedValue /}
				{param showAsSwitcher: $showAsSwitcher /}
				{param showLabel: $showLabel /}
				{param value: $value /}
			{/call}
		{/param}
		{param errorMessage: $errorMessage /}
		{param id: $id /}
		{param label: $label /}
		{param name: $name /}
		{param ref: 'base' /}
		{param repeatable: $repeatable /}
		{param required: $required /}
		{param showLabel: $showLabel /}
		{param spritemap: $spritemap /}
		{param tip: $tip /}
		{param valid: $valid /}
		{param visible: $visible /}
	{/call}
{/template}

{template .content}
	{@param name: string}
	{@param value: ?}
	{@param? _handleFieldChanged: any}
	{@param? disabled: bool}
	{@param? inline: bool}
	{@param? options: list<[
		label: string,
		value: string
	]>}
	{@param? predefinedValue: list<any>}
	{@param? showAsSwitcher: bool}

	{let $displayValue: $value ? $value : $predefinedValue /}

	<div class="form-group">
		{if $options}
			{foreach $option in $options}
				{let $checked kind="text"}
					{if $displayValue}
						{foreach $currentValue in $displayValue}
							{if $currentValue == $option.value}
								checked
							{/if}
						{/foreach}
					{/if}
				{/let}

				{if $showAsSwitcher}
					<div class="lfr-ddm-form-field-checkbox-switch  {if $inline} lfr-ddm-form-field-checkbox-switch-inline {/if}">
						<label class="simple-toggle-switch toggle-switch">
							{let $attributes kind="attributes"}
								class="toggle-switch-check"
								data-index="{index($option)}"
								data-onchange="{$_handleFieldChanged}"

								{if $checked == 'checked'}
									checked
								{/if}

								{if $disabled}
									disabled
								{/if}
								name="{$name}"
								ref="input{index($option)}"
								type="checkbox"
							{/let}

							<input {$attributes} />

							<span aria-hidden="true" class="toggle-switch-bar">
								<span class="toggle-switch-handle"></span>
							</span>
							<span class="toggle-switch-label">{$option.label}</span>
						</label>
					</div>
				{else}
					{call ClayCheckbox.render}
						{param checked: $checked == 'checked' ? true : false /}
						{param disabled: $disabled /}
						{param events: [
							'change': $_handleFieldChanged
						] /}
						{param inline: $inline /}
						{param label: $option.label /}
						{param name: $name /}
						{param ref: 'input' + index($option) /}
						{param value: $option.value /}
					{/call}
				{/if}
			{/foreach}
		{/if}
	</div>
{/template}